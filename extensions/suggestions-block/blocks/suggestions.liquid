{{ 'suggestions.css' | asset_url | stylesheet_tag }}

<div
  class="app-suggestions"
  data-product-id="{{ product.id }}"
  data-proxy-url="{{ shop.url }}/apps/suggestions/for-product"
  data-max-items="{{ block.settings.max_items }}"
  data-layout="{{ block.settings.layout }}"
>
  <h2 class="app-suggestions__heading">{{ block.settings.heading }}</h2>
  <div class="app-suggestions__container">
    <div class="app-suggestions__skeleton">
      <div class="app-suggestions__skeleton-card"></div>
      <div class="app-suggestions__skeleton-card"></div>
      <div class="app-suggestions__skeleton-card"></div>
    </div>
  </div>
</div>

<script src="{{ 'suggestions.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Suggestions",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "max_items",
      "label": "Maximum items",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    }
  ]
}
{% endschema %}
